{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "node",
    "declaration": true,
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,

    /* Linting */
    "strict": true,
    "outDir": "../../dist/node"
  },
  "include": ["../../src"]
}
